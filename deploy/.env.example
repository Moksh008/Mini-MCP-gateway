# Copy to ./.env (repository root, next to docker-compose.yml). Never commit .env.

# Public hostname pointing at this server (A/AAAA record). Caddy gets the TLS cert automatically.
DOMAIN=mcp-gateway.example.com

# OpenRouter key for the AI Agent page (https://openrouter.ai/keys).
# Tip: create a dedicated key with a credit limit for the public demo.
OPENROUTER_API_KEY=sk-or-v1-...

# Credential the gateway injects when calling the mock payments backend.
PAYMENTS_API_TOKEN=change-me-to-a-random-string
